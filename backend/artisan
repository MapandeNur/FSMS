<?php

define('LARAVEL_START', microtime(true));

if (file_exists($maintenance = __DIR__.'/storage/framework/maintenance.php')) {
    require $maintenance;
}

require __DIR__.'/vendor/autoload.php';

// Include bootstrap safely
$app = require __DIR__.'/bootstrap/app.php';

// Forcefully resolve the application object if it was loaded early
if ($app === 1 || !is_object($app)) {
    if (isset($GLOBALS['app'])) {
        $app = $GLOBALS['app'];
    } elseif (class_exists(\Illuminate\Container\Container::class)) {
        $app = \Illuminate\Container\Container::getInstance();
    }
}

// Emergency check: If it's still not an object, stop and see what it is
if (!is_object($app)) {
    var_dump($app);
    die("\n[DEBUG] Laravel application instance could not be created.\n");
}

$status = $app->handleCommand(Symfony\Component\Console\Input\ArgvInput::create());

exit($status);
